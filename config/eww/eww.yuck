;; Wallpaper dashboard. Which widgets are on is managed by `widgets`
;; (config/eww/widgets.conf); a widget's poll only runs while it is on and
;; the dashboard is open. To add one: a show_<name> var, its polls with
;; :run-while, a (slot ...) below, and a line in widgets.conf.

(defvar show_agenda true)   (defvar show_tasks true)    (defvar show_system true)
(defvar show_markets true)  (defvar show_focus true)    (defvar show_weather true)
(defvar show_projects true) (defvar show_net true)      (defvar show_music false)
(defvar show_inbox false)   (defvar show_month false)    (defvar show_services false)

(defpoll clock    :interval "20s" :initial "" "date '+%H:%M'")
(defpoll day      :interval "10m" :initial "" "date '+%A %d %B'")
(defpoll agenda   :interval "5m"  :initial "" :run-while show_agenda   "khal list now 2d --format '{start-time} {title}' 2>/dev/null | head -7")
(defpoll tasks    :interval "2m"  :initial "" :run-while show_tasks    "task rc.verbose=nothing rc.report.next.columns=description rc.report.next.labels= limit:7 next 2>/dev/null")
(defpoll health   :interval "1m"  :initial "" :run-while show_system   "health")
(defpoll hosts    :interval "1m"  :initial "" :run-while show_system   "hp --list")
(defpoll quotes   :interval "5m"  :initial "" :run-while show_markets  "mkt --plain")
(defpoll hubmode  :interval "5s"  :initial "" :run-while show_focus    "cat ~/.local/state/hub/mode 2>/dev/null")
(defpoll focus    :interval "20s" :initial "" :run-while show_focus    "focus --text")
(defpoll tracked  :interval "1m"  :initial "" :run-while show_focus    "timew summary :day 2>/dev/null | awk '$NF ~ /^[0-9]+:[0-9][0-9]:[0-9][0-9]$/ { last = $NF } END { print (last ? last : \"0:00\") }'")
(defpoll weather  :interval "10m" :initial "" :run-while show_weather  "weather")
(defpoll projects :interval "1m"  :initial "" :run-while show_projects "pj -l | awk '$1 == \"wip\" || $1 == \"plan\" || $1 == \"paused\"' | head -8")
(defpoll netinfo  :interval "30s" :initial "" :run-while show_net      "net")
(defpoll music    :interval "5s"  :initial "" :run-while show_music    "playerctl metadata --format '{{ status }}\n{{ title }}\n{{ artist }}' 2>/dev/null || echo 'nothing playing'")
(defpoll inboxtxt :interval "1m"  :initial "" :run-while show_inbox    "tail -n 7 ~/doc/notes/inbox.md 2>/dev/null | cut -c3-")
(defpoll services :interval "1m" :initial "" :run-while show_services "probe")
(defpoll month    :interval "1h"  :initial "" :run-while show_month    "cal -m | sed 's/_\\x08//g'")

(defwidget slot [title show]
  (box :class "panel" :visible show :orientation "v" :space-evenly false :spacing 6
    (label :class "title" :xalign 0 :text title)
    (children)))

(defwidget text [value ?class]
  (label :class "body ${class}" :xalign 0 :yalign 0 :text value))

(defwidget dash []
  (box :class "dash" :orientation "v" :spacing 6 :space-evenly false
    (box :spacing 6 :space-evenly true
      (slot :title "${clock}   ${day}" :show show_agenda (text :value {agenda == "" ? "nothing scheduled" : agenda}))
      (slot :title "TASKS" :show show_tasks (text :value {tasks == "" ? "no open tasks" : tasks}))
      (slot :title "FOCUS" :show show_focus
        (text :value "mode  ${hubmode == '' ? '–' : hubmode}")
        (text :value focus)
        (text :class "dim" :value "tracked today  ${tracked}"))
      (slot :title "PROJECTS" :show show_projects (text :class "mono" :value {projects == "" ? "none in progress" : projects})))
    (box :spacing 6 :space-evenly true
      (slot :title "SYSTEM" :show show_system
        (text :value "cpu ${round(EWW_CPU.avg, 0)}%   ram ${round(EWW_RAM.used_mem_perc, 0)}%   disk ${round(EWW_DISK['/'].used_perc, 0)}%")
        (text :class "bad" :value health)
        (text :class "dim" :value hosts))
      (slot :title "NETWORK" :show show_net (text :class "mono" :value netinfo))
      (slot :title "MARKETS" :show show_markets (text :class "mono" :value quotes))
      (slot :title "WEATHER" :show show_weather (text :value weather)))
    (box :spacing 6 :space-evenly true
      (slot :title "MUSIC" :show show_music (text :value music))
      (slot :title "INBOX" :show show_inbox (text :value {inboxtxt == "" ? "inbox is empty" : inboxtxt}))
      (slot :title "MONTH" :show show_month (text :class "mono" :value month))
      (slot :title "SERVICES" :show show_services (text :class "mono" :value services)))))

(defwindow dash-bottom
  :monitor 0 :stacking "bg" :exclusive false :focusable false
  :geometry (geometry :y "36px" :width "94%" :anchor "bottom center")
  (dash))

(defwindow dash-top
  :monitor 0 :stacking "bg" :exclusive false :focusable false
  :geometry (geometry :y "36px" :width "94%" :anchor "top center")
  (dash))

;; Settings window (`settings`, Super+Shift+W): palette and widgets by click.
;; Its state comes from `settings json`; a click runs `settings do ...`.
(defvar settings '{"palettes":[],"walls":[],"widgets":[],"hidden":false,"pos":"bottom"}')

(defwidget settings-panel []
  (box :class "settings" :orientation "v" :space-evenly false :spacing 10
    (box :class "title" :space-evenly false
      (label :hexpand true :xalign 0 :text "SETTINGS")
      (button :class "close" :onclick "eww close settings" "×"))
    (label :class "head" :xalign 0 :text "THEME   every app follows, instantly")
    (box :class "body" :orientation "v" :spacing 4 :space-evenly false
      (for p in {settings.palettes}
        (button :class "row ${p.current ? 'on' : ''}" :onclick "settings do theme ${p.name} &"
          (box :space-evenly false :spacing 8
            (box :class "swatch" :style "background-color: #${p.bg}; border-color: #${p.fg}"
              (label :style "color: #${p.acc}" :text "■")
              (label :style "color: #${p.fg}" :text "■")
              (label :style "color: #${p.ok}" :text "■")
              (label :style "color: #${p.crit}" :text "■"))
            (label :xalign 0 :text "${p.current ? '●' : '○'} ${p.name}")))))
    (label :class "head" :xalign 0 :text "WALLPAPER   ~/med/img/wall, one per palette")
    (box :class "body" :orientation "v" :space-evenly false
      (label :class "dim" :xalign 0 :visible {arraylength(settings.walls) == 0} :text "no images in ~/med/img/wall yet")
      (scroll :vscroll true :hscroll false :height {min(arraylength(settings.walls), 4) * 52}
        (box :orientation "v" :spacing 4 :space-evenly false
          (for w in {settings.walls}
            (button :class "row ${w.current ? 'on' : ''}" :onclick "settings do theme wall '${w.name}'"
              (box :space-evenly false :spacing 8
                (image :path {w.path} :image-width 72 :image-height 40)
                (label :xalign 0 :limit-width 28 :text "${w.current ? '●' : '○'} ${w.name}")))))))
    (label :class "head" :xalign 0 :text "WIDGETS   on the wallpaper of empty workspaces")
    (box :class "body" :orientation "v" :spacing 4 :space-evenly false
      (box :spacing 4
        (button :class "row" :onclick "settings do widgets ${settings.hidden ? 'show' : 'hide'}"
          "${settings.hidden ? '○' : '●'} dashboard")
        (button :class "row" :onclick "settings do widgets pos ${settings.pos == 'top' ? 'bottom' : 'top'}"
          "position: ${settings.pos}"))
      (box :orientation "v" :spacing 4 :space-evenly false
        (for w in {settings.widgets}
          (button :class "row ${w.on ? 'on' : ''}" :onclick "settings do widgets ${w.on ? 'off' : 'on'} ${w.name}"
            (label :xalign 0 :text "${w.on ? '[x]' : '[ ]'} ${w.name}")))))
    (label :class "dim" :xalign 0 :text "same as: theme <name>, widgets on|off <name>")))

(defwindow settings
  :monitor 0 :stacking "overlay" :exclusive false :focusable false
  :geometry (geometry :x "16px" :y "40px" :width "380px" :anchor "top right")
  (settings-panel))
