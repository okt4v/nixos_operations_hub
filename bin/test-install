#!/usr/bin/env bash
# test-install [whole|dual|replace|tui] — install a small test host with the
# real installer in a VM, boot it, unlock the disk over SSH (remote unlock),
# check it came up. dual/replace/tui first put a fake Windows (EFI, C:, D:)
# on the disk; dual installs into the free space after it, replace over D:.
# whole/dual/replace use the installer's no-questions mode; tui goes through
# its menus by keystroke like a person (tmux): first a new host with its
# feature and app lists up to the summary (cancelled), then a real install
# into the free space. About 10 minutes each; needs KVM.
#   bin/test-install [mode]    (hub test-install)
set -euo pipefail
mode=${1:-whole}
repo=$(dirname "$(dirname "$(readlink -f "$0")")")
tmp=$(mktemp -d)
trap 'kill "$(cat "$tmp/qemu.pid" 2>/dev/null)" 2>/dev/null || true; rm -rf "$tmp"' EXIT
cd "$tmp"
tool() { nix build --no-link --print-out-paths "nixpkgs#$1"; }
expect=$(tool expect)/bin/expect
ovmf=$(tool OVMF.fd)/FV
ssh-keygen -q -t ed25519 -N "" -f key
cp "$ovmf/OVMF_VARS.fd" vars.fd && chmod u+w vars.fd
qemu-img create -q -f qcow2 disk.qcow2 80G

# The real ISO plus a throwaway host `smoke` (core + disk + boot + remote
# unlock, 1.5 GB) and this run's ssh key.
echo "building the test ISO"
iso=$(nix build --no-link --print-out-paths --impure --expr "
  let
    f = builtins.getFlake \"git+file://$repo\";
    pkgs = f.nixosConfigurations.iso.pkgs;
    key = \"$(cat key.pub)\";
    smoke = pkgs.writeText \"smoke.nix\" ''
      { modulesPath, ... }: {
        imports = [ (modulesPath + \"/profiles/qemu-guest.nix\") ../../modules/core.nix ../../modules/disk.nix ../../modules/boot.nix ../../modules/remote-unlock.nix ];
        nixpkgs.hostPlatform = \"x86_64-linux\";
        hub.disk = \"/dev/nvme0n1\";
        services.openssh.enable = true;
        users.users.root.openssh.authorizedKeys.keys = [ \"\${key}\" ];
        boot.initrd.network.ssh.authorizedKeys = [ \"\${key}\" ];
      }
    '';
    src = pkgs.runCommand \"hub-test-src\" { } ''
      cp -r \${f} \$out && chmod -R u+w \$out
      mkdir \$out/hosts/smoke && cp \${smoke} \$out/hosts/smoke/default.nix
    '';
  in
  (f.nixosConfigurations.iso.extendModules {
    modules = [ ({ lib, ... }: {
      environment.etc.\"hub\".source = lib.mkForce src;
      users.users.root.openssh.authorizedKeys.keys = [ key ];
    }) ];
  }).config.system.build.isoImage")
iso=$(echo "$iso"/iso/*.iso)

vm() { # vm <extra qemu args...>
  qemu-system-x86_64 -enable-kvm -cpu host -smp 4 -m 6G \
    -drive if=pflash,format=raw,readonly=on,file="$ovmf/OVMF_CODE.fd" \
    -drive if=pflash,format=raw,file=vars.fd -drive file=disk.qcow2,if=virtio \
    -nic user,model=virtio,hostfwd=tcp::2224-:22,hostfwd=tcp::2225-:2222 \
    -display none -vga std -daemonize -pidfile "$tmp/qemu.pid" "$@"
}
opts=(-i key -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o LogLevel=ERROR -o ConnectTimeout=3)
s() { ssh "${opts[@]}" -p 2224 root@localhost "$@"; }
up() { for _ in $(seq 60); do ssh "${opts[@]}" -p "$1" root@localhost true </dev/null 2>/dev/null && return; sleep 5; done; echo "FAIL: no ssh on $1" >&2; exit 1; }

echo "booting the ISO"
vm -cdrom "$iso" -boot order=d
up 2224

layout=whole
if [ "$mode" != whole ]; then
  echo "making a fake Windows: EFI partition with a marker file, a 5G C: and a 32G D: partition"
  s 'sgdisk -n 0:0:+100M -t 0:ef00 -n 0:0:+5G -t 0:0700 -n 0:0:+32G -t 0:0700 /dev/vda && udevadm settle &&
     mkfs.vfat /dev/vda1 >/dev/null && mount /dev/vda1 /mnt && mkdir -p /mnt/EFI/Microsoft &&
     touch /mnt/EFI/Microsoft/windows && umount /mnt'
  # dual (and tui): into the free space after it; replace: over D:
  if [ "$mode" = replace ]; then layout=/dev/vda3; else layout=free; fi
fi

if [ "$mode" = tui ]; then
  echo "driving the installer's menus (screen: tui.txt)"
  tmux=$(tool "tmux^out")/bin/tmux
  T() { "$tmux" -L "hubtest$$" "$@"; }
  trap 'T kill-server 2>/dev/null; kill "$(cat "$tmp/qemu.pid" 2>/dev/null)" 2>/dev/null || true; rm -rf "$tmp"' EXIT
  start() { T kill-server 2>/dev/null || true; T new -d -s t -x 120 -y 40 "TERM=linux ssh ${opts[*]} -tt -p 2224 root@localhost hub-install; sleep 7200"; }
  shown() { T capture-pane -p -t t >tui.txt; grep -qF -- "$1" tui.txt; }
  see() { # see <text> [seconds]: wait until the screen shows it
    for _ in $(seq "${2:-90}"); do shown "$1" && return; sleep 1; done
    cat tui.txt; echo "FAIL: the installer never showed: $1" >&2; exit 1
  }
  key() { T send-keys -t t "$@"; sleep 0.7; }
  type_() { key C-u; T send-keys -t t -l "$1"; sleep 0.3; key Enter; } # replace an input field
  answers() { # time zone .. login password, the same in both passes
    see " Time zone "; type_ America/New_York
    see " Disk "; key Enter
    see " How "; shown "Use the free space" || { cat tui.txt; echo "FAIL: no free-space choice" >&2; exit 1; }
    key Enter # free space is the default
    see " Size "; type_ 35
    see " Disk passphrase "; type_ test; see "Once more"; type_ test
    see " Login password "; type_ pw; see "Once more"; type_ pw
    see " Ready "
  }
  # pass 1: a new host, its features and apps; stop at the summary
  start
  see "Welcome to ophub NixOS"; key Enter
  see " Keyboard "; key u; key Enter
  see " Host "; key End; key Enter
  see " New host "; type_ tui-test
  see " Features "; key Space; key Enter
  see " Apps "; key Space; key Enter
  answers
  for t in "tui-test (new)" "America/New_York" "Keyboard:   us" "Uses 35 GiB"; do
    shown "$t" || { cat tui.txt; echo "FAIL: summary lacks: $t" >&2; exit 1; }
  done
  key Enter # the default is No: nothing is installed
  # pass 2: the small test host, installed for real
  start
  see "Welcome to ophub NixOS"; key Enter
  see " Keyboard "; key u; key Enter
  see " Host "; key s; key Enter
  answers
  key i # Install
  see " Header backup " 3600; key Tab; key Enter # Skip
  see " Done " 120
else
echo "running hub-install, $mode (log: install.log)"
s "printf test > /tmp/pp && hub-install --host smoke --disk /dev/vda --layout $layout --passphrase-file /tmp/pp \
     --password pw --timezone America/New_York --keyboard us --header-backup /tmp/hdr.img --yes" > install.log 2>&1 \
  || { tail -30 install.log; echo "FAIL: installer" >&2; exit 1; }
s 'cryptsetup luksDump /tmp/hdr.img >/dev/null' || { echo "FAIL: no LUKS header backup" >&2; exit 1; }
fi
kill "$(cat qemu.pid)"; sleep 2

echo "booting the installed disk, unlocking over SSH"
vm
cat > unlock.exp <<EXP
set timeout 60
spawn ssh ${opts[*]} -tt -p 2225 root@localhost
expect {
  -re "(?i)passphrase" { send "test\r" }
  eof { exit 1 }
  timeout { exit 2 }
}
expect eof
EXP
# the initrd's ssh logs straight into the passphrase prompt; retry until it is up
ok=
for _ in $(seq 40); do "$expect" unlock.exp > unlock.log 2>&1 && { ok=1; break; }; sleep 5; done
[ -n "$ok" ] || { tail -20 unlock.log; echo "FAIL: remote unlock" >&2; exit 1; }
up 2224
# shellcheck disable=SC2016 # runs in the VM
s 'grep -q "ophub NixOS" /etc/os-release && [ "$(stat -c %U /home/oktav/tec/nix/flake.nix)" = oktav ] &&
   readlink /etc/localtime | grep -q New_York && grep -q "XKB_DEFAULT_LAYOUT=\"us\"" /etc/set-environment' \
  || { echo "FAIL: installed system" >&2; exit 1; }
if [ "$mode" != whole ]; then
  # shellcheck disable=SC2016 # runs in the VM
  s '[ -f /efi/EFI/Microsoft/windows ] && [ "$(lsblk -no PARTTYPE /dev/vda2)" = ebd0a0a2-b9e5-4433-87c0-68b6b72699c7 ] &&
     [ "$(lsblk -no PARTLABEL "$(findmnt -no SOURCE /boot)")" = nixos-boot ] && ls /boot/EFI/nixos >/dev/null' \
    || { echo "FAIL: dual boot layout" >&2; exit 1; }
  # dual keeps D:, replace has put nixos-boot where it was
  # shellcheck disable=SC2016 # runs in the VM
  [ "$mode" = replace ] || s '[ "$(lsblk -no PARTTYPE /dev/vda3)" = ebd0a0a2-b9e5-4433-87c0-68b6b72699c7 ]' \
    || { echo "FAIL: D: is gone" >&2; exit 1; }
fi
echo "PASS ($mode): installed, booted, unlocked over SSH, repo at hub.dir"
