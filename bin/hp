#!/usr/bin/env bash
# hp [--bar] — host picker. Lists tailnet machines and SSH-config hosts,
# opens SSH with a resumed tmux session on the one you pick.
set -eu

hosts() {
  {
    tailscale status --json 2>/dev/null | jq -r '.Peer[]? | "\(.HostName)\t\(if .Online then "online" else "offline" end)"'
    awk '$1 == "Host" && $2 !~ /[*?]/ { print $2 "\tssh" }' "$HOME/.ssh/config" 2>/dev/null
  } | awk -F'\t' '!seen[$1]++'
}

if [ "${1:-}" = --bar ]; then
  hosts | awk -F'\t' '$2 != "ssh" { n++; if ($2 == "online") up++ } END { if (n) printf "hosts %d/%d\n", up, n }'
  exit 0
fi

if [ "${1:-}" = --list ]; then
  hosts | awk -F'\t' '$2 != "ssh" { printf "%-14s %s\n", $1, $2 }'
  exit 0
fi

if [ -t 0 ]; then pick=$(hosts | fzf --prompt='host> ' --height=40% --reverse); else pick=$(hosts | fuzzel --dmenu --prompt 'host> '); fi
host=${pick%%$'\t'*}
[ -n "$host" ] || exit 0
exec kitty --title "$host" ssh -t "$host" 'tmux new -A -s main 2>/dev/null || exec $SHELL -l'
