#!/usr/bin/env bash
# settings — a window to click the look together: palette (theme), wallpaper
# (~/med/img/wall, remembered per palette), the wallpaper widgets and the
# optional apps (`apps`; installed by `hub switch`, the Apply button).
# Super+Shift+W opens and closes it.
#   settings            open/close the window (eww, config/eww/eww.yuck)
#   settings json       its state as JSON (palettes, walls, widgets, dashboard)
#   settings do <cmd>   what a click runs: `theme <name>`, `widgets ...`, `apps on|off <name>`
#   settings apply      run `hub switch` in a terminal, for the apps picked here
# Every change is the same as the command line: `theme`, `widgets`.
set -eu

pal=${XDG_CONFIG_HOME:-$HOME/.config}/pal
state=${XDG_STATE_HOME:-$HOME/.local/state}/hub
hub=$(dirname "$(dirname "$(readlink -f "$0")")")
walls=$HOME/med/img/wall

json() {
  local cur
  cur=$(readlink "$pal/current" 2>/dev/null || echo dark)
  printf '{"palettes":['
  local sep=
  for f in "$hub"/config/palette/*; do
    # shellcheck disable=SC2034 # read through the printf below
    local name kind bg fg sel mute acc ok warn crit
    name=$(basename "$f")
    # shellcheck source=/dev/null
    . "$f"
    printf '%s{"name":"%s","bg":"%s","fg":"%s","acc":"%s","ok":"%s","crit":"%s","current":%s}' \
      "$sep" "$name" "$bg" "$fg" "$acc" "$ok" "$crit" "$([ "$name" = "$cur" ] && echo true || echo false)"
    sep=,
  done
  printf '],"widgets":['
  sep=
  while read -r st name; do
    printf '%s{"name":"%s","on":%s}' "$sep" "$name" "$([ "$st" = on ] && echo true || echo false)"
    sep=,
  done < <(widgets list)
  printf '],"walls":%s' "$(find "$walls" -maxdepth 1 -type f -printf '%f\n' 2>/dev/null | sort |
    jq -Rnc --arg dir "$walls" --arg cur "$(readlink "$walls/current" 2>/dev/null)" \
      '[inputs | {name: ., path: ($dir + "/" + .), current: ($dir + "/" + . == $cur)}]')"
  printf ',"apps":%s' "$(apps list 2>/dev/null | jq -Rnc '[inputs | capture("^(?<st>\\S+)\\s+(?<name>\\S+)\\s+(?<desc>.*)$") | {name, desc, on: (.st == "on")}]')"
  printf ',"pending":%s' "$([ -e "$state/apps-pending" ] && echo true || echo false)"
  printf ',"hidden":%s,"pos":"%s"}\n' "$([ -e "$state/widgets-hidden" ] && echo true || echo false)" \
    "$(cat "$state/widgets-pos" 2>/dev/null || echo bottom)"
}
refresh() { eww update settings="$(json)"; }

case ${1:-} in
  json) json ;;
  do)
    shift
    case ${1:-} in
      theme | widgets) "$@" >/dev/null ;;
      apps) "$@" >/dev/null && touch "$state/apps-pending" ;; # installed by the next switch
      *) echo "settings: do theme|widgets|apps ..." >&2; exit 1 ;;
    esac
    # `theme` reloads eww, which closes this window and resets its state
    [ "$1 ${2:-}" = "theme wall" ] || [ "$1" != theme ] || eww open settings >/dev/null 2>&1
    refresh
    ;;
  apply) # install/remove the apps picked here: hub switch in a terminal (it asks for sudo)
    eww close settings 2>/dev/null || true
    exec kitty --hold sh -c "hub switch && rm -f '$state/apps-pending' && echo && echo 'Apps are in place.'"
    ;;
  '')
    eww daemon >/dev/null 2>&1 || true
    if eww active-windows 2>/dev/null | grep -q '^settings'; then eww close settings; else refresh; eww open settings; fi
    ;;
  *) echo "usage: settings [json|do <cmd>|apply]" >&2; exit 1 ;;
esac
