#!/usr/bin/env bash
# doctor — is this machine fully set up? Checks every one-time step from
# docs/INSTALL.md and says what to run for the ones still open.
set -u

hub=$(dirname "$(dirname "$(readlink -f "$0")")")
todo=0
ok() { printf '\033[32m ok \033[0m %s\n' "$1"; }
no() { printf '\033[33mtodo\033[0m %s\n       → %s\n' "$1" "$2"; todo=$((todo + 1)); }
check() { if eval "$2" >/dev/null 2>&1; then ok "$1"; else no "$1" "$3"; fi; }

check "repo is where the system expects it" '[ "$hub" = "${NH_FLAKE:-${NH_OS_FLAKE:-$hub}}" ]' "move the repo to the path in hub.dir (modules/core.nix), or change hub.dir"
check "repo has a commit and a remote" 'git -C "$hub" rev-parse HEAD && [ -n "$(git -C "$hub" remote)" ]' "git -C $hub commit, then add a remote and push"
check "SSH public key present" '[ -f ~/.ssh/id_ed25519.pub ]' "restore ~/.ssh (commits are signed with this key)"
check "SSH key available in the agent" 'ssh-add -l' "open KeePassXC; enable 'add key to agent' on the SSH key entry"
check "age key for secrets" '[ -f ~/.config/sops/age/keys.txt ]' "hub sec"
check "secrets file" '[ -f "$hub/secrets/secrets.yaml" ]' "hub sec"
check "vault created" '[ -f ~/dat/vlt/gocryptfs.conf ]' "hub vault open"
check "Tailscale logged in" '[ "$(tailscale status --json | jq -r .BackendState)" = Running ]' "sudo tailscale up"
check "Mullvad logged in" 'mullvad account get | grep -qi "account"' "mullvad account login <number>"
check "trusted wifi list set" 'systemctl is-enabled net-trust' "hub.net.trusted = [ \"ssid\" ]; in the host file, then hub switch"
check "a backup target enabled" '[ -n "$(systemctl list-unit-files "restic-backups-*.service" --no-legend)" ]' "hub feature on backupExternal (or backupHomelab, backupCloud), then hub switch"
check "wallpaper chosen" '[ -e ~/med/img/wall/current ]' "ln -s <image> ~/med/img/wall/current"
check "work git identity" '[ -f ~/.config/git/work ]' "create ~/.config/git/work with a [user] section"
check "school git identity" '[ -f ~/.config/git/school ]' "create ~/.config/git/school with a [user] section"
check "calendar synced" '[ -n "$(ls ~/.local/share/cal 2>/dev/null)" ]' "secret 'icloud', hub feature on calendar, hub switch, vdirsyncer discover"
check "disk has room (under 85% full)" '[ "$(df --output=pcent / | tail -1 | tr -dc 0-9)" -lt 85 ]' "hub gc; hub disk shows what uses your home"
check "repo committed and pushed" '[ -z "$(git -C "$hub" status --porcelain)" ] && [ "$(git -C "$hub" rev-list --count "@{u}..")" = 0 ]' "commit in $hub and git push"
# a program in ~/.local/bin (e.g. a self-updating installer) hides the Nix one
shadowed=$(for f in ~/.local/bin/*; do n=$(basename "$f"); [ -e "/etc/profiles/per-user/$USER/bin/$n" ] || [ -e "/run/current-system/sw/bin/$n" ] && echo "$n"; done 2>/dev/null | xargs)
check "nothing in ~/.local/bin hides a Nix program" '[ -z "$shadowed" ]' "in ~/.local/bin, remove: $shadowed (then the Nix versions are used)"
if grep -q "remoteUnlock = true" "$hub/hosts/$(hostname)/features.nix" 2>/dev/null; then
  check "remote unlock host key" 'sudo -n test -f /var/lib/initrd-ssh/ssh_host_ed25519_key' "sudo mkdir -p /var/lib/initrd-ssh && sudo ssh-keygen -t ed25519 -N '' -f /var/lib/initrd-ssh/ssh_host_ed25519_key, then hub switch"
fi
check "Secure Boot" 'sbctl status | grep -qi "secure boot.*enabled"' "optional, see docs/INSTALL.md section 5"

echo
if [ "$todo" -eq 0 ]; then echo "everything is set up"; else echo "$todo open"; fi
