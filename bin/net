#!/usr/bin/env bash
# net [--bar] — network at a glance: wifi, address, VPN, tailnet.
set -u

ssid=$(iwctl station wlan0 show 2>/dev/null | awk '/Connected network/ { $1=$2=""; sub(/^ +/, ""); sub(/ +$/, ""); print }')
ip=$(ip -4 -o addr show scope global 2>/dev/null | awk '$2 !~ /^(docker|virbr|br-|tailscale|wg)/ { split($4, a, "/"); print a[1]; exit }')
vpn=$(mullvad status 2>/dev/null | head -1)
ts=$(tailscale ip -4 2>/dev/null | head -1)
trust=$(cat /run/net-trust 2>/dev/null)

if [ "${1:-}" = --bar ]; then
  case $vpn in Connected*) text=vpn class=on ;; *) text="" class=off ;; esac
  printf '{"text":"%s","class":"%s","tooltip":"wifi %s\\naddress %s\\n%s\\ntailnet %s"}\n' "$text" "$class" "${ssid:--}" "${ip:--}" "${vpn:-vpn -}" "${ts:--}"
else
  printf 'wifi     %s%s\naddress  %s\nvpn      %s\ntailnet  %s\n' "${ssid:--}" "${trust:+ ($trust)}" "${ip:--}" "${vpn:--}" "${ts:--}"
fi
