#!/usr/bin/env bash
# sec — edit the encrypted secrets (secrets/secrets.yaml) with sops.
# First use creates your age key and the sops rule for it.
set -eu

hub=$(dirname "$(dirname "$(readlink -f "$0")")")
key=$HOME/.config/sops/age/keys.txt

if [ ! -f "$key" ]; then
  mkdir -p "$(dirname "$key")"
  age-keygen -o "$key"
  chmod 600 "$key"
  echo "New age key: $key"
  echo "Back it up in KeePassXC now. Without it the secrets cannot be decrypted."
fi

cd "$hub"
[ -f .sops.yaml ] || printf 'creation_rules:\n  - path_regex: secrets/.*\\.yaml$\n    age: %s\n' "$(age-keygen -y "$key")" >.sops.yaml
sops secrets/secrets.yaml
git add .sops.yaml secrets/secrets.yaml 2>/dev/null || true
