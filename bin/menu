#!/usr/bin/env bash
# menu [section] — one launcher for everything that isn't "start an app".
# Without a section it lists them. Sections are plain case branches: add one
# by adding a branch and its name to the list.
set -eu

pick() { fuzzel --dmenu --prompt "$1> "; }
conf=$(dirname "$(dirname "$(readlink -f "$0")")")/config

case ${1:-} in
  "")
    sec=$(printf '%s\n' windows projects modes widgets hosts services notes links snip card minutes mail grab qr focus clipboard calc emoji pw audio wifi bluetooth vpn night wall kill pass theme power | pick menu) || exit 0
    exec "$0" "$sec"
    ;;
  windows)
    id=$(swaymsg -t get_tree | jq -r '.. | objects | select(.pid != null and .type != "workspace")
      | "\(.id)\t\(.app_id // .window_properties.class // "?")  \(.name)"' | pick window | cut -f1) || exit 0
    swaymsg "[con_id=$id] focus" >/dev/null
    ;;
  projects) exec kitty pj ;;
  modes) exec mode ;;
  widgets) exec widgets ;;
  hosts) exec hp ;;
  services) exec kitty --hold probe ;;
  card) exec card ;;
  minutes) exec minutes ;;
  mail) exec pad mail ;;
  notes) exec note find ;;
  grab) exec grab "$(printf '%s\n' text tex qr color | pick grab)" ;;
  focus)
    what=$(printf '%s\n' 25 50 90 stop | pick 'focus minutes') || exit 0
    exec focus "$what"
    ;;
  clipboard) cliphist list | pick clip | cliphist decode | wl-copy ;;
  calc)
    expr=$(pick calc </dev/null) || exit 0
    res=$(qalc -t "$expr")
    wl-copy "$res"
    notify-send -t 4000 "$expr" "= $res (copied)"
    ;;
  emoji) BEMOJI_PICKER_CMD='fuzzel --dmenu --prompt emoji>' exec bemoji -c -n ;;
  audio)
    sink=$(pactl -f json list sinks | jq -r '.[] | "\(.name)\t\(.description)"' | pick output | cut -f1) || exit 0
    pactl set-default-sink "$sink"
    ;;
  wifi) exec kitty impala ;;
  bluetooth) exec kitty bluetui ;;
  links) # config/links: name, then the URL
    url=$(grep -vE '^\s*(#|$)' "$conf/links" | pick link | awk '{ print $NF }') || exit 0
    [ -z "$url" ] || exec xdg-open "$url"
    ;;
  snip) # config/snippets: name, two or more spaces, text
    line=$(grep -vE '^\s*(#|$)' "$conf/snippets" | pick snippet) || exit 0
    printf '%b' "$(printf '%s' "$line" | sed -E 's/^[^ ]+( [^ ]+)*  +//')" | wl-copy
    ;;
  qr) exec qr ;;
  pw) # a new random password, pasteable once
    LC_ALL=C tr -dc 'A-Za-z0-9!#%+=?@_-' </dev/urandom | head -c 24 | wl-copy --paste-once
    notify-send -t 3000 "Password" "24 characters in the clipboard, for one paste"
    ;;
  vpn)
    what=$(printf '%s\n' connect disconnect reconnect "$(mullvad relay list | awk '/^[A-Z].*\([a-z]{2}\)$/ { gsub(/[()]/, "", $NF); print $NF "  " $0 }')" | pick vpn | awk '{ print $1 }') || exit 0
    case $what in
      connect | disconnect | reconnect) mullvad "$what" ;;
      ??) mullvad relay set location "$what" && mullvad connect ;;
    esac
    ;;
  night) exec night ;;
  wall) # pick the wallpaper from ~/med/img/wall
    dir=$HOME/med/img/wall
    img=$(find "$dir" -maxdepth 1 -type f -printf '%f\n' | sort | pick wallpaper) || exit 0
    ln -sfn "$dir/$img" "$dir/current"
    swaymsg reload >/dev/null
    ;;
  kill)
    pid=$(ps -u "$USER" -o pid=,pmem=,comm= --sort=-pmem | head -40 | pick kill | awk '{ print $1 }') || exit 0
    [ -z "$pid" ] || kill "$pid"
    ;;
  pass) exec pad pass ;;
  theme) exec settings ;;
  power)
    case $(printf '%s\n' lock suspend logout reboot poweroff | pick power) in
      lock) loginctl lock-session ;;
      suspend) systemctl suspend ;;
      logout) swaymsg exit ;;
      reboot) systemctl reboot ;;
      poweroff) systemctl poweroff ;;
    esac
    ;;
  *) echo "menu: no section '$1'" >&2; exit 1 ;;
esac
